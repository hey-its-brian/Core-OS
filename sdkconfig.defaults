# ---- Target / flash --------------------------------------------------------
# M5Stack CoreS3 Lite: ESP32-S3, 16 MB flash, 8 MB octal PSRAM, native USB.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- Cache / PSRAM ---------------------------------------------------------
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Static buffers marked DECK_PSRAM_BSS (deck_attr.h) live in PSRAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# ---- Stacks ----------------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- Board support (espressif/m5stack_core_s3) ------------------------------
# 40 lines of RGB565, double buffered, in internal DMA memory: 51 KB.
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=40
CONFIG_BSP_LCD_DRAW_BUF_DOUBLE=y
CONFIG_BSP_I2C_NUM=1
CONFIG_BSP_SD_MOUNT_POINT="/sdcard"
CONFIG_BSP_ERROR_CHECK=y

# ---- LVGL ------------------------------------------------------------------
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=256
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
# Widgets are allocated in PSRAM (components/deck_hal/lv_mem_psram.c) so the
# S3's internal RAM stays free for Wi-Fi, TLS and the display DMA buffers.
CONFIG_LV_USE_CUSTOM_MALLOC=y

# ---- Storage ---------------------------------------------------------------
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# ---- Network -----------------------------------------------------------------
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# HKDF for the vault sync (LiveSync E2EE v2)
CONFIG_MBEDTLS_HKDF_C=y
# lwIP's 5.7 KB default window caps a 20 ms link at about 2.5 Mbit/s.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16

# ---- OTA ---------------------------------------------------------------------
# A new build must confirm itself (deck_ota, OTA_CONFIRM_S) or the bootloader
# rolls back. Lives in the bootloader, so it arrives with one USB flash.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Encrypted settings (Wi-Fi password, vault passphrase): XTS keys derived from
# an HMAC key that the firmware generates and burns into a free eFuse key
# block on first boot (deck_hal picks the block and falls back to plain NVS).
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
# Required to be valid, but unused: deck_hal picks the block at runtime and
# nothing calls the stock nvs_flash_init().
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=5

CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
